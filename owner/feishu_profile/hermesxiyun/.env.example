# hermesxiyun profile 环境变量模板
# 复制此文件为 .env 并填入真实值

# damodel (NewAPI 公网代理 via genai.damodel.com)
DAMODEL_API_KEY=YOUR_DAMODEL_API_KEY

# dashscope (阿里云 DashScope)
DASHSCOPE_API_KEY=YOUR_DASHSCOPE_API_KEY

# deepseek
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY

# hermes api server
API_SERVER_MODEL_NAME=deepseek-v4-flash
API_SERVER_KEY=YOUR_API_SERVER_KEY
API_SERVER_ENABLED=true

# dashboard
HERMES_DASHBOARD_INSECURE=1

# terminal
TERMINAL_ENV=local

# api server port (区分于主 profile 默认 8642)
API_SERVER_PORT=26026

# 飞书凭证（用于调用飞书 API 回复消息，但 adapter 在 config.yaml 中禁用）
FEISHU_APP_ID=YOUR_FEISHU_APP_ID
FEISHU_APP_SECRET=YOUR_FEISHU_APP_SECRET

# Qdrant (qdrant-memory-recall hook)
QDRANT_URL=http://localhost:6333
QDRANT_KEY=YOUR_QDRANT_KEY

# DAMODEL (for qdrant-memory-recall hook embedding)
DAMODEL_BASE_URL=https://genai.damodel.com/v1

# 允许所有用户访问 gateway
GATEWAY_ALLOW_ALL_USERS=true
